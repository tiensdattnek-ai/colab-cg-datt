# Colab-CG-DATT — Sunshine low-latency profile
sunshine_name = __NAME__
origin_web_ui_allowed = wan
upnp = disabled
address_family = both
port = 47989

# --- capture ---
capture = x11
output_name = 0
min_log_level = info

# --- stream ---
fps = [30,60,90,120]
resolutions = [1280x720,1600x900,1920x1080,2560x1440]
channels = 2
audio_sink = ccg.monitor

# --- do tre ---
# FEC thap = it overhead = it tre (mang on dinh); tang len neu mat goi
fec_percentage = __FEC__
qp = __QP__
min_threads = 4
# gui frame ngay khi encode xong, khong doi vblank
nvenc_realtime_hags = enabled
nvenc_latency_over_power = enabled
nvenc_preset = 1
nvenc_twopass = disabled
nvenc_spatial_aq = disabled
nvenc_vbv_increase = 20
encoder = __ENCODER__
__CODECLINE__

{
  "env": { "PATH": "$(PATH):$(HOME)/.local/bin" },
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png",
      "prep-cmd": [
        { "do": "xfconf-query -c xfwm4 -p /general/use_compositing -s false", "undo": "" }
      ]
    },
    {
      "name": "Steam Big Picture",
      "detached": ["setsid steam -gamepadui"],
      "image-path": "steam.png"
    },
    {
      "name": "Low Latency 720p",
      "prep-cmd": [
        { "do": "xrandr --output default --mode 1280x720", "undo": "xrandr --output default --mode 1920x1080" }
      ]
    }
  ]
}
